gf_dist_aitchison <- dist(mat_clr, method = "euclidean")
###### Analysis based on Aitchison distance
### PCoA
gf_pcoa_ait <- ape::pcoa(gf_dist_aitchison)
# Extract first two axes
bc_scores <- as.matrix(pcoa_bc$vectors[, 1:2])
ait_scores <- as.matrix(pcoa_ait$vectors[, 1:2])
rownames(bc_scores) <- sub("_all_merged_Abundance$", "", rownames(bc_scores))
rownames(ait_scores) <- sub("_all_merged_Abundance$", "", rownames(ait_scores))
# Check sample order
stopifnot(identical(rownames(bc_scores), rownames(ait_scores)))
# Procrustes analysis
proc_path_bc_path_ait <- procrustes(X = bc_scores, Y = ait_scores, scale = TRUE)
# Print summary
summary(proc_path_bc_path_ait)
# Permutation test for concordance
set.seed(123)
protest_path_bc_path_ait <- protest(bc_scores, ait_scores, permutations = 9999)
print(protest_path_bc_path_ait)
plot(proc_path_bc_path_ait, kind = 1, main = "Procrustes: Pathway-based Bray-Curtis vs Aitchison PCoA")
text(proc_path_bc_path_ait$X, labels = rownames(bc_scores), pos = 3, cex = 0.7)
###### Procrustes between pathway-based BC and gene family-based BC Distance
# Compare the first two PCoA axes (2D ordination structure)
# pcoa_bc should be generated previously from pathway-based Bray-Curtis distance
stopifnot(exists("pcoa_bc"))
path_bc_scores <- as.matrix(pcoa_bc$vectors[, 1:2])
gf_bc_scores <- as.matrix(gf_pcoa_bc$vectors[, 1:2])
rownames(path_bc_scores) <- sub("_all_merged_Abundance$", "", rownames(path_bc_scores))
rownames(gf_bc_scores) <- sub("_all_merged_Abundance-RPKs$", "", rownames(gf_bc_scores))
# Check sample order
stopifnot(identical(rownames(path_bc_scores), rownames(gf_bc_scores)))
# Procrustes analysis
proc_path_bc_gf_bc <- procrustes(X = path_bc_scores, Y = gf_bc_scores, scale = TRUE)
# Print summary
summary(proc_path_bc_gf_bc)
# Permutation test for concordance
set.seed(123)
protest_path_bc_gf_bc <- protest(path_bc_scores, gf_bc_scores, permutations = 9999)
print(protest_path_bc_gf_bc)
plot(proc_path_bc_gf_bc, kind = 1, main = "Procrustes: Pathway vs Gene Family PCoA (Bray-Curtis)")
text(proc_path_bc_gf_bc$X, labels = rownames(path_bc_scores), pos = 3, cex = 0.7)
# Summary of Procrustes Results
procrustes_summary_df <- tibble(
comparison = c("Pathway BC vs Pathway Aitchison", "Pathway BC vs Gene family BC"),
correlation = c(protest_path_bc_path_ait$t0, protest_path_bc_gf_bc$t0),
p_value = c(protest_path_bc_path_ait$signif, protest_path_bc_gf_bc$signif)
)
print(procrustes_summary_df)
library(pheatmap)
### Rename Sample Names
clean_sample_names <- function(x) {
x <- sub("_all_merged_Abundance-RPKs$", "", x)
x <- sub("_all_merged_Abundance$", "", x)
x
}
### Extract Profile Axis
path_bc_scores <- as.matrix(pcoa_bc$vectors[, 1:2])
path_ait_scores <- as.matrix(pcoa_ait$vectors[, 1:2])
gf_bc_scores <- as.matrix(gf_pcoa_bc$vectors[, 1:2])
gf_ait_scores <- as.matrix(gf_pcoa_ait$vectors[, 1:2])
rownames(path_bc_scores) <- clean_sample_names(rownames(path_bc_scores))
rownames(path_ait_scores) <- clean_sample_names(rownames(path_ait_scores))
rownames(gf_bc_scores) <- clean_sample_names(rownames(gf_bc_scores))
rownames(gf_ait_scores) <- clean_sample_names(rownames(gf_ait_scores))
score_list <- list(
Pathway_BC = path_bc_scores,
Pathway_Aitchison = path_ait_scores,
GeneFamily_BC = gf_bc_scores,
GeneFamily_Aitchison = gf_ait_scores
)
### Run Pairwise Procrustes
run_pairwise_procrustes <- function(mat1, mat2, name1, name2, permutations = 9999) {
# keep common samples only
common_samples <- intersect(rownames(mat1), rownames(mat2))
mat1 <- mat1[common_samples, , drop = FALSE]
mat2 <- mat2[common_samples, , drop = FALSE]
# ensure same order
stopifnot(identical(rownames(mat1), rownames(mat2)))
proc <- procrustes(X = mat1, Y = mat2, scale = TRUE)
prot <- protest(mat1, mat2, permutations = permutations)
tibble(
profile1 = name1,
profile2 = name2,
comparison = paste(name1, "vs", name2),
n_samples = nrow(mat1),
n_axes = ncol(mat1),
procrustes_correlation = prot$t0,
p_value = prot$signif
)
}
### Pairwise Compare
library(purrr)
library(tibble)
library(dplyr)
pair_ids <- combn(names(score_list), 2, simplify = FALSE)
pairwise_procrustes_results <- purrr::map_dfr(pair_ids, function(x) {
run_pairwise_procrustes(
mat1 = score_list[[x[1]]],
mat2 = score_list[[x[2]]],
name1 = x[1],
name2 = x[2],
permutations = 9999
)
})
print(pairwise_procrustes_results)
### Saving Results
procrustes_table_file <- file.path("../../tmp_figures", "pairwise_procrustes_results.tsv")
write.table(
pairwise_procrustes_results,
file = procrustes_table_file,
sep = "\t",
quote = FALSE,
row.names = FALSE
)
### Correlation matrix
profiles <- names(score_list)
corr_mat <- matrix(NA_real_, nrow = length(profiles), ncol = length(profiles),
dimnames = list(profiles, profiles))
p_mat <- matrix(NA_real_, nrow = length(profiles), ncol = length(profiles),
dimnames = list(profiles, profiles))
diag(corr_mat) <- 1
diag(p_mat) <- 0
for (i in seq_len(nrow(pairwise_procrustes_results))) {
r <- pairwise_procrustes_results[i, ]
corr_mat[r$profile1, r$profile2] <- r$procrustes_correlation
corr_mat[r$profile2, r$profile1] <- r$procrustes_correlation
p_mat[r$profile1, r$profile2] <- r$p_value
p_mat[r$profile2, r$profile1] <- r$p_value
}
### Heatmap with p values
library(ComplexHeatmap)
library(circlize)
library(grid)
# labels: show only correlations
label_mat <- matrix("", nrow = nrow(corr_mat), ncol = ncol(corr_mat),
dimnames = dimnames(corr_mat))
for (i in seq_len(nrow(corr_mat))) {
for (j in seq_len(ncol(corr_mat))) {
if (!is.na(corr_mat[i, j])) {
label_mat[i, j] <- sprintf("%.2f", corr_mat[i, j])
}
}
}
# Keep only lower triangle
corr_mat_plot <- corr_mat
corr_mat_plot[upper.tri(corr_mat_plot)] <- NA
label_mat_plot <- label_mat
label_mat_plot[upper.tri(label_mat_plot)] <- ""
# More publication-friendly names
nice_names <- c(
"Pathway (BC)",
"Pathway (Aitchison)",
"Gene family (BC)",
"Gene family (Aitchison)"
)
rownames(corr_mat_plot) <- nice_names
colnames(corr_mat_plot) <- nice_names
rownames(label_mat_plot) <- nice_names
colnames(label_mat_plot) <- nice_names
# White -> yellow -> red palette
col_fun <- colorRamp2(
c(0.68, 0.79, 0.90),
c("#fff7ec", "#fdd49e", "#d7301f")
)
# Draw heatmap
ht <- Heatmap(
corr_mat_plot,
name = "Procrustes\ncorrelation",
col = col_fun,
na_col = "white",
cluster_rows = FALSE,
cluster_columns = FALSE,
rect_gp = gpar(col = NA),   # remove borders
border = FALSE,
row_names_side = "left",
column_names_side = "bottom",
row_names_gp = gpar(fontsize = 11),
column_names_gp = gpar(fontsize = 11),
column_names_rot = 90,
cell_fun = function(j, i, x, y, width, height, fill) {
if (!is.na(corr_mat_plot[i, j])) {
grid.text(
label_mat_plot[i, j],
x = x, y = y,
gp = gpar(fontsize = 10, col = "#4d4d4d")
)
}
},
heatmap_legend_param = list(
title = "Procrustes\ncorrelation",
at = c(0.70,  0.80, 0.90),
labels = c("0.70",  "0.80", "0.90"),
legend_direction = "vertical",
title_gp = gpar(fontsize = 11, fontface = "bold"),
labels_gp = gpar(fontsize = 10)
),
column_title = "Pairwise Procrustes Correlations",
column_title_gp = gpar(fontsize = 14, fontface = "bold")
)
figure_file <- file.path("../../tmp_figures/", "Func_Pairwise_Procrustes.jpg")
jpeg(filename = figure_file, width = 6, height = 5, units = "in", res = 300)
draw(ht, heatmap_legend_side = "right")
dev.off()
